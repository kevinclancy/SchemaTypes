%{
open System
open Surface.Syntax
open ParseHelpers
open Utils

%}

%start sort
%type <Sort> sort

%start formula
%type <Formula> formula

%start ty
%type <Ty> ty

%start kind
%type <Kind> kind

// (most recent comment, identifier string)
%token <string*string> ID
%token <char> CHAR
%token <int> INT
%token <string> STRLITERAL
// (string is most recent comment)
%token <string> LSQUAREBRACK
%token RSQUAREBRACK DOUBLECOLON PREDICATES END BANG LET IN EQUAL
%token STR PROOF PRED TO LPAREN RPAREN COLON TRUE PIPE
%token LBARBRACK RBARBRACK LANGLE RANGLE EOF ASTERISK TYPE
%token LBRACK RBRACK JOIN DOT BACKSLASH HASH MAPSTO COMMA

%left PIPE AND OR PLUS MINUS EQUALS
%right TO

%% 

sort : Sort EOF { $1 }

StrSort : STR { SsString }
        | STRLITERAL { SsLit($1) }

Sort : StrSort { StStr($1, parseState.ResultRange) }
     | PROOF Formula { StProof($2, parseState.ResultRange) }
     | PredSort { $1 }

// The formals of an n-ary predicate. They are divided into a string section and a proof section,
// which are separated by a PIPE.
PredFormals : LPAREN RPAREN { makePredSig [] [] }
            | LPAREN StringFormals RPAREN { makePredSig $2 [] }
            | LPAREN StringFormals PIPE PredAppList RPAREN { makePredSig $2 $4 }

PredSort : PRED PredFormals { StPred($2, parseState.ResultRange) }

StringFormals : ID COLON StrSort COMMA StringFormals { (snd $1, $3) :: $5 }
              | ID COLON StrSort { [(snd $1, $3)] }

Atom : STRLITERAL { AtomLit($1) }
     | ID { AtomVar(snd $1) }

AtomList : Atom COMMA AtomList { $1 :: $3 }
         | Atom { [$1] }

PredApp : ID LPAREN AtomList RPAREN { makePredApp (snd $1) $3 }
        | ID LPAREN RPAREN { makePredApp (snd $1) [] }

PredAppList : PredApp COMMA PredAppList { $1 :: $3 }
            | PredApp { [$1] }

// introduces a predicate, which is in scope in the definitions that follow it
PredDef : ID PredFormals { (snd $1, StPred($2, parseState.ResultRange)) }

PredDefList : { [] }
            | PredDef PredDefList { $1 :: $2 }

formula : Formula EOF { $1 }

Formula : TRUE { FmTrue }
        | PredApp { FmApp($1) }

// a proposition bounding the keys of a dictionary
Guard : Formula { ($1, parseState.ResultRange) }

GuardList : Guard COMMA GuardList { $1 :: $3 }
          | Guard { [$1] }

kind : Kind EOF { $1 }

Kind : ASTERISK { KProper(parseState.ResultRange) }
     | ASTERISK ASTERISK { KProperPopulated(parseState.ResultRange) }
     | Kind TO Kind { KTyFun($1, $3, parseState.ResultRange) }
     | LPAREN ID COLON Sort RPAREN TO Kind { KIndFun(snd $2, $4, $7, parseState.ResultRange) }

ty : Type EOF { $1 }

Type : SimpleType { $1 }
     | LPAREN ApplicationSequence RPAREN { $2 }


IdBinding : ID COLON StrSort { (snd $1, $3) }
          | ID { (snd $1, SsString) }

IdList : IdBinding COMMA IdList { $1 :: $3 }
       | IdBinding { [$1] }

SimpleType : LBRACK LSQUAREBRACK IdList RSQUAREBRACK GuardList COLON Type RBRACK { makeDictChain $3 $5 $7 parseState.ResultRange }
     | LBRACK LSQUAREBRACK IdList RSQUAREBRACK COLON Type RBRACK { makeAnonDictChain $3 $6 parseState.ResultRange }
     | LBRACK FieldList RBRACK { TyRecord($2, parseState.ResultRange) }
     | LBRACK ID COLON StrSort PIPE Formula RBRACK { TyStringRef(snd $2, $4, $6, parseState.ResultRange) }
     | LPAREN ID COLON Sort RPAREN MAPSTO Type { TyIndAbs(snd $2, $4, $7, parseState.ResultRange) }
     | LPAREN ID DOUBLECOLON Kind RPAREN MAPSTO Type { TyTyAbs(snd $2, $4, $7, parseState.ResultRange) }
     | PREDICATES PredDefList END Type { makePredicates $2 $4 parseState.ResultRange }
     | STR { TyStringRef("_", SsString, FmTrue, parseState.ResultRange) }
     | STRLITERAL { TyStringRef("_", SsLit($1), FmTrue, parseState.ResultRange) }
     | ID { TyVar(snd $1, parseState.ResultRange) }
     | LetList { $1 }
     | Sort MAPSTO Type { TyIndAbs("_", $1, $3, parseState.ResultRange) }

LetList : TYPE ID EQUAL Type LetList { TyLet(snd $2, $4, $5, parseState.ResultRange) } 
        | IN Type { $2 }

// Unlike predicates, index-to-type functions are curried: they are applied to one argument at a time
ApplicationSequence : ApplicationSequence Atom { TyIndApp($1, $2, parseState.ResultRange) }
                    | ApplicationSequence BANG Type { TyTyApp($1, $3, parseState.ResultRange) }
                    | Type { $1 }

Field : ID COLON Type { (snd $1, $3) }

FieldList : Field COMMA FieldList { $1 :: $3 }
          | Field { [$1] }